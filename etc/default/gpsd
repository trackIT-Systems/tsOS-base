# Default settings for gpsd.
# Please do not edit this file directly - use `dpkg-reconfigure gpsd' to
# change the options.
START_DAEMON="true"
# -b: read-only, gpsd never writes to a device. Its probes block on a modem's NMEA port while
# the GNSS is off (a Quectel EG21-G never drains them), and with them all of gpsd. tslocationd
# switches the GNSS through ModemManager, not through gpsd (docs/location.md).
GPSD_OPTIONS="-n -b"
DEVICES=""
USBAUTO="false"
GPSD_SOCKET="/var/run/gpsd.sock"
