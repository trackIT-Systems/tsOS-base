[Unit]
Description=Web-based configuration and system management interface
After=network.target

[Service]
# Runs as pi, not root (see docs/security.md) - every privileged action it
# performs (config writes, service restarts, network changes, reboot) is
# authorized by a polkit rule or plain group membership, exactly like an
# interactive pi shell session; there is no sudo involved anywhere in this
# design. NoNewPrivileges is deliberately NOT set here: it would also block
# this process's own use of pkexec for the one remaining root-mediated
# config-write wrapper.
User=pi
Group=pi
Nice=10
Environment="TERM=xterm-256color"
Environment="TSCONFIG_CONFIG_FILE=/etc/tsconfig/tsconfig.yml"
WorkingDirectory=/usr/local/src/tsconfig
# Holds the session signing key (tmpfs): logins survive a restart of tsconfig, not a reboot
RuntimeDirectory=tsconfig
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# Caddy keeps idle connections to tsconfig for up to 2 minutes; uvicorn closes them after 5 s by
# default, and a request Caddy sends on one just as it closes fails with 502. Keep them open longer
# than Caddy does, so Caddy is always the side that closes them.
ExecStart=python3 -m uvicorn app.main:app --timeout-keep-alive 300
SyslogIdentifier=tsconfig

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
