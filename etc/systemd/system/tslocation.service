[Unit]
Description=tslocationd: measured positions and tracks from GNSS, next to the configured reference
# gpsd reads the receiver, ModemManager switches it; the daemon also runs without either (no fix)
After=gpsd.socket ModemManager.service mosquitto.service
Wants=gpsd.socket mosquitto.service

[Service]
# Runs as pi like tstelemetry; 40-tsos-modemmanager-location.rules lets pi switch the modem's
# GNSS through ModemManager. See docs/security.md, "Location daemon". Its settings,
# /boot/firmware/tslocation.yml, hold data only.
User=pi
Group=pi
Type=notify
NotifyAccess=main
WatchdogSec=120
# location.json and geolocation (the effective position, /etc/geolocation points here) for other
# services. Kept across restarts, so readers do not see the files vanish; gone after a reboot.
RuntimeDirectory=tslocation
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# state.json: the known cells and the latest fine fix, across reboots
StateDirectory=tslocation
# MQTT and gpsd over loopback, ModemManager over D-Bus, chronyc over loopback UDP, daily CSV files in /data
ReadWritePaths=-/data
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
ExecStart=/usr/local/bin/tslocationd
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
