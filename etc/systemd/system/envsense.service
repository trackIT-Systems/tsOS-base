[Unit]
Description=envsensed environmental sensor daemon
After=network-online.target
Wants=network-online.target
# Measurements need a trusted clock: no start before time-sync.target (see docs/time.md)
After=time-sync.target
Requires=time-sync.target
# Records to /data: runs only while the data volume (datafs or a USB disk that devmon
# bind-mounts) is mounted, so nothing is written into the root overlay. BindsTo stops it when
# the volume goes away, WantedBy=data.mount starts it when it appears (tsOS-base docs/architecture.md)
RequiresMountsFor=/data
BindsTo=data.mount

[Service]
Type=simple
# Only needs to read i2c sensors and SoC temperature, read its boot-partition
# config, and write CSV output to /data - never needed root. See
# docs/security.md.
DynamicUser=yes
SupplementaryGroups=i2c
ReadWritePaths=/data
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ExecStart=/usr/bin/env envsensed
SyslogIdentifier=envsensed
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target data.mount
