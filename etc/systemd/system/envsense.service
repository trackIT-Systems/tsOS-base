[Unit]
Description=envsensed environmental sensor daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Uses /boot/firmware/envsense.yml by default. Override with:
# ExecStart=/usr/bin/env envsensed --config /path/to/envsense.yml
ExecStart=/usr/bin/env envsensed
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
