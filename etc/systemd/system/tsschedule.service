[Unit]
Description=Sensor station schedule daemon (wake/sleep)
Documentation=https://github.com/trackit-systems/tsschedule
After=time-set.target
# Feeds the checked RTC to chrony's SOCK reference clock, which chronyd creates (docs/time.md)
After=chrony.service
Wants=chrony.service
# /etc/geolocation points to tslocationd's effective position, read at startup: after the daemon
# has written it (Type=notify). Ordering only, tsschedule also starts without it.
After=tslocation.service
Requires=time-set.target

[Service]
Nice=10
ExecStart=/usr/local/bin/tsscheduled --schedule /boot/firmware/schedule.yml
Restart=always
RestartSec=300s
User=root

[Install]
WantedBy=multi-user.target
