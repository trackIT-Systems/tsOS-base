[Unit]
Description=filebrowser
After=network.target

[Service]
Nice=10
# Runs as pi, like everything else that handles the station's data, so files
# created through the web UI or WebDAV belong to the operator account. It does
# not authenticate users itself: Caddy checks pi's password (through tsconfig,
# PAM) and tells it who is calling (auth.methods.proxy in
# /etc/filebrowser/filebrowser.yml), and it listens on loopback only. A
# vulnerability in it is therefore a pi-level compromise; the sandbox below
# limits it to /data and its own state directory, and NoNewPrivileges also
# keeps it away from pkexec/tsconfig-privileged. See docs/security.md.
User=pi
Group=pi
StateDirectory=filebrowser
ReadWritePaths=/data
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ExecStart=/usr/bin/filebrowser -c /etc/filebrowser/filebrowser.yml
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
