[Unit]
Description=solarlifed SolarLife MPPT BLE daemon (CSV + MQTT)
# Nothing to do without a Bluetooth controller (same condition as bluetooth.service)
ConditionPathIsDirectory=/sys/class/bluetooth
# tsos-bluetooth-address powers the controller off to change its address: scan and connect only afterwards
After=bluetooth.service tsos-bluetooth-address.service mosquitto.service
Wants=bluetooth.service tsos-bluetooth-address.service mosquitto.service

[Service]
Type=simple
# Runs as pi like mqttutil, so pi (web shell, SSH) can use the `solarlife` CLI on the control socket
# in /run/solarlife (0660) without any group. Unlike envsense and tsconfig-ble it is therefore not a
# separate user: the sandbox below is all that holds it back. See docs/security.md, "SolarLife daemon".
User=pi
Group=pi
RuntimeDirectory=solarlife
RuntimeDirectoryMode=0750
# BlueZ is reached over D-Bus (any user may call it), MQTT over loopback, CSV goes to /data
ReadWritePaths=/data
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
ExecStart=/usr/bin/env solarlifed
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
