[Unit]
Description=tsOS Configuration Manager - BLE GATT Gateway
After=network.target bluetooth.target tsconfig.service
# Wants, not Requires: restarting tsconfig must not take the BLE gateway (and its connections) down
Wants=bluetooth.target tsconfig.service

[Service]
# The gateway reports readiness and pings the watchdog while it is registered with BlueZ
Type=notify
NotifyAccess=main
WatchdogSec=60
Nice=10
# Own user in `shadow` (hash login) - see docs/security.md, "BLE".
# No NoNewPrivileges: the root password login runs the setuid `su`.
User=tsconfig-ble
Group=tsconfig-ble
WorkingDirectory=/usr/local/src/tsconfig
ExecStart=python3 -m app.ble_gateway --api-url http://localhost:8000
SyslogIdentifier=tsconfig-ble
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

