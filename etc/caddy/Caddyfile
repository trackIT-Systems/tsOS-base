{
    # HTTPS is optional: plain HTTP on :80 keeps working and is never
    # redirected to HTTPS.
    auto_https disable_redirects
    # Certificates come from Caddy's own local CA (`tls internal` below). Don't
    # try to add its root to the device's trust store; clients that want to
    # verify the device import that root themselves (see docs/security.md).
    skip_install_trust
    # Clients connecting by IP address send no SNI; give them the .local
    # certificate instead of failing the handshake.
    default_sni {$TSOS_HOSTNAME}.local
}

(tsos) {
    encode gzip
    reverse_proxy http://localhost:8000

    handle /data* {
        # Filebrowser trusts X-Forwarded-User to say who is calling, so this block
        # is the only place that header may come from. `route` keeps the written
        # order (plain directives would be reordered, and the Authorization
        # rewrite below would then hit the check instead of Filebrowser).
        route {
            request_header -X-Forwarded-User

            # tsconfig verifies pi's password: the session cookie for the web UI,
            # HTTP Basic for WebDAV (it only accepts Basic for /data/dav/). On
            # failure its redirect to the login page, or 401/429, goes to the client.
            forward_auth localhost:8000 {
                uri /auth/check
            }

            # Filebrowser's WebDAV handler insists on a Basic header but, with
            # proxy auth, ignores the password. Replace it so pi's real password
            # never reaches Filebrowser.
            @dav path /data/dav /data/dav/*
            request_header @dav Authorization "Basic dTp4"

            reverse_proxy http://localhost:8080 {
                header_up Host {host}
                header_up X-Forwarded-Proto {scheme}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-User pi
                flush_interval -1
            }
        }
    }
}

:80 {
    import tsos
}

# TSOS_HOSTNAME comes from caddy.service.d/tsos-hostname.conf. 169.254.0.1 is
# the device's address on its own hotspot.
https://{$TSOS_HOSTNAME}, https://{$TSOS_HOSTNAME}.local, https://localhost, https://169.254.0.1 {
    tls internal
    import tsos
}

# Any other address (station or cellular IP): served the default_sni certificate.
:443 {
    tls internal
    import tsos
}
