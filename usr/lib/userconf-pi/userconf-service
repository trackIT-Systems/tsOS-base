#!/bin/sh -e
# Replacement for Raspberry Pi OS's userconf-service, for tsOS (see docs/security.md).
#
# Applies /boot/firmware/userconf(.txt) - `pi:<crypt hash>` - on every boot, so a
# config bundle can change pi's password at any time. Upstream applies it once:
# its helper /usr/lib/userconf-pi/userconf ends in cancel-rename, which disables
# userconfig.service, and it also resets the shell to bash. This script therefore
# does the one thing needed itself and never calls that helper (nor cancel-rename).
# No interactive dialog, no renaming: only the user `pi` is accepted.

if ! FWLOC=$(/usr/lib/raspberrypi-sys-mods/get_fw_loc 2> /dev/null); then
    FWLOC=/boot
fi

for BOOT_CONF_FILE in "$FWLOC/userconf" "$FWLOC/userconf.txt"; do
    [ -f "$BOOT_CONF_FILE" ] || continue

    LINE="$(head -n1 "$BOOT_CONF_FILE" | dos2unix)"
    NEW_USER="$(echo "$LINE" | cut -f1 -d:)"
    NEW_PASS="$(echo "$LINE" | cut -f2 -d:)"

    if [ "$NEW_USER" = "pi" ] && [ -n "$NEW_PASS" ]; then
        echo "pi:$NEW_PASS" | chpasswd -e
        rm "$BOOT_CONF_FILE"
    else
        echo "Invalid $BOOT_CONF_FILE: expected 'pi:<crypt hash>'" | tee -a "$BOOT_CONF_FILE" >&2
        mv "$BOOT_CONF_FILE" "$FWLOC/failed_$(basename "$BOOT_CONF_FILE")"
        sync
    fi
    break
done
