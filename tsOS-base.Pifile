FROM https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-09-15/2026-09-15-raspios-trixie-arm64-lite.img.xz
TO "tsOS-base-arm64.img"
PUMP 500M

# Set os-release info
NAME="tsOS"
VARIANT="Base"
VERSION_CODENAME="Barbastella"

VERSION_ID=`git describe --tags --always || true`
VERSION_COMMIT=`git rev-parse --verify HEAD`

RUN tee /etc/os-release <<EOF
PRETTY_NAME="$NAME $VARIANT $VERSION_ID ($VERSION_CODENAME)"
NAME=$NAME
ID="${NAME,,}"
ID_LIKE=debian
VARIANT=$VARIANT
VARIANT_ID=${VARIANT,,}
VERSION_ID=$VERSION_ID
VERSION="$VERSION_ID ($VERSION_CODENAME)"
VERSION_COMMIT=$VERSION_COMMIT
VERSION_CODENAME=$VERSION_CODENAME
HOME_URL="https://trackit.systems/"
SUPPORT_URL="https://github.com/trackIT-Systems/tsOS-base"
BUG_REPORT_URL="https://github.com/trackIT-Systems/tsOS-base/issues"
EOF

# write build process entry
RUN tee -a /boot/firmware/issue.txt <<EOF
Modified using pimod, https://github.com/trackIT-Systems/tsOS-base, $VERSION_COMMIT, $VERSION_ID
EOF

#################################################
### install software

ENV PIP_ROOT_USER_ACTION ignore
ENV PIP_BREAK_SYSTEM_PACKAGES 1

# No man pages, docs or translations: keep dpkg from installing them, and drop
# the base image's - except what 01-tsos-nodoc keeps (copyright, locale.alias)
INSTALL etc/dpkg/dpkg.cfg.d/01-tsos-nodoc /etc/dpkg/dpkg.cfg.d/01-tsos-nodoc
RUN find /usr/share/man -mindepth 1 -delete
RUN find /usr/share/doc /usr/share/locale -mindepth 1 ! -type d ! -name copyright ! -name locale.alias -delete
RUN find /usr/share/doc /usr/share/locale -mindepth 1 -type d -empty -delete

# Remove what the base image brings but nothing uses: video tools, babel locale data,
# remote access, PGP CLI and kernel headers (no DKMS)
RUN apt-get purge -y --auto-remove mkvtoolnix python3-babel python-babel-localedata rpi-connect-lite sq '~nlinux-headers-'

# Update OS and sources
RUN apt-get update

# Install basic software
RUN apt-get install -y \
    python3 python3-pip \
    i2c-tools \
    vim \
    git \
    mosh \
    zsh

# Remove compilers and Python dev headers: all pip installs are pure Python. Not earlier,
# as python3-pip recommends build-essential and python3-dev, and recommends are only
# disabled once etc/apt/apt.conf.d is installed.
RUN apt-get purge -y --auto-remove build-essential gcc g++ gdb python3-dev libpython3.13-dev

# Install networking tools
RUN apt-get install -y \
    tcpdump \
    wireguard-tools \
    modemmanager

# Install overlayroot
RUN apt-get install -y overlayroot

# Install Raspberry Pi Tools
RUN apt-get install -y rpiboot

# Install caddy
RUN apt-get install -y caddy

# Install FileBrowser Quantum
RUN curl -L -o filebrowser https://github.com/gtsteffaniak/filebrowser/releases/download/v1.5.6-stable/linux-arm64-filebrowser
RUN chmod +x filebrowser
RUN mv filebrowser /usr/bin/filebrowser

# Install mosquitto
RUN apt-get install -y mosquitto mosquitto-clients

# Install python system packages
RUN apt-get install -y python3-dbus

# Install GPS / NTP software
RUN apt-get purge -y systemd-timesyncd
RUN apt-get install --no-install-recommends -y \
    gpsd \
    gpsd-tools \
    geoclue-2.0 \
    chrony

# Install udevil / devmon automount packages
RUN apt-get install -y udevil

RUN apt-get clean

#################################################
### custom files

# Backup fstab
RUN cp /etc/fstab /etc/fstab.default 

# Create mount points
RUN mkdir -p /media/datafs
RUN mkdir -p /media/clonefs
RUN mkdir -p /media/root-rw
RUN mkdir -p /media/root-ro
RUN mkdir -p /data

# Install custom folders
INSTALL boot /boot
INSTALL etc /etc
INSTALL home /home
INSTALL opt /opt
INSTALL var /var
INSTALL usr /usr

# Copy git repositories
RUN rm /opt/oh-my-zsh/.git
INSTALL .git/modules/opt/oh-my-zsh /opt/oh-my-zsh/.git
RUN rm /usr/local/src/pymqttutil/.git
INSTALL .git/modules/usr/local/src/pymqttutil /usr/local/src/pymqttutil/.git
RUN rm /usr/local/src/pysmartsolar/.git
INSTALL .git/modules/usr/local/src/pysmartsolar /usr/local/src/pysmartsolar/.git
RUN rm /usr/local/src/pysolarlife/.git
INSTALL .git/modules/usr/local/src/pysolarlife /usr/local/src/pysolarlife/.git
RUN rm /usr/local/src/tsconfig/.git
INSTALL .git/modules/usr/local/src/tsconfig /usr/local/src/tsconfig/.git
RUN rm /usr/local/src/tsupdate/.git
INSTALL .git/modules/usr/local/src/tsupdate /usr/local/src/tsupdate/.git
RUN rm /usr/local/src/tsflash/.git
INSTALL .git/modules/usr/local/src/tsflash /usr/local/src/tsflash/.git
RUN rm /usr/local/src/vedirect_dump/.git
INSTALL .git/modules/usr/local/src/vedirect_dump /usr/local/src/vedirect_dump/.git
RUN rm /usr/local/src/tsschedule/.git
INSTALL .git/modules/usr/local/src/tsschedule /usr/local/src/tsschedule/.git
RUN rm /usr/local/src/vcgencmd/.git
INSTALL .git/modules/usr/local/src/vcgencmd /usr/local/src/vcgencmd/.git
RUN rm /usr/local/src/pyenvsense/.git
INSTALL .git/modules/usr/local/src/pyenvsense /usr/local/src/pyenvsense/.git

# Fix permissions for pi user
RUN chown -R pi:pi /home/pi/

# Root-owned, readable by pi (e.g. for debugging) but not writable - see docs/security.md.
RUN chown -R root:root /usr/local/src
RUN chmod -R go-w /usr/local/src

# Root now owns /usr/local/src - let pi's git commands there work without "dubious ownership" errors.
RUN sh -c 'for d in /usr/local/src/*/; do git config --system --add safe.directory "${d%/}"; done'

# Drop dev artifacts INSTALL copies from a local checkout (macOS venvs, test caches, ...).
# Must stay before the `pip install -e` steps, which regenerate the egg-info.
RUN find /usr/local/src \( -name .venv -o -name .pytest_cache -o -name .mypy_cache -o -name .ruff_cache -o -name htmlcov -o -name .pdm-build -o -name __pycache__ -o -name '*.egg-info' -o -name .DS_Store \) -prune -exec rm -rf {} +

# polkitd/pkexec aren't in the base image the way sudo is - install explicitly.
RUN apt-get install -y polkitd pkexec

# pi's privileged helper, run as root via pkexec - see docs/security.md.
RUN chown root:root /usr/local/sbin/tsconfig-privileged
RUN chmod 755 /usr/local/sbin/tsconfig-privileged

#################################################
### basic configuration

# Fix permissions on host ssh files
RUN sh -c 'chown root:root /etc/ssh/ssh_host_*'
RUN sh -c 'chmod 600 /etc/ssh/ssh_host_*_key'
RUN sh -c 'chmod 644 /etc/ssh/ssh_host_*_key.pub'
RUN systemctl disable regenerate_ssh_host_keys

# Install user ssh files and fix permissions
INSTALL home/pi/.ssh /home/pi/.ssh
RUN chown pi:pi /home/pi
RUN chown pi:pi /home/pi/.ssh
RUN chown pi:pi /home/pi/.ssh/authorized_keys
RUN chmod 755   /home/pi
RUN chmod 700   /home/pi/.ssh
RUN chmod 644   /home/pi/.ssh/authorized_keys

# Install root ssh files and fix permissions. Manufacturer-controlled keys,
# independent of the operator-editable boot partition - see docs/security.md.
INSTALL root/.ssh /root/.ssh
RUN chown root:root /root
RUN chown root:root /root/.ssh
RUN chown root:root /root/.ssh/authorized_keys
RUN chmod 755       /root
RUN chmod 700       /root/.ssh
RUN chmod 644       /root/.ssh/authorized_keys

# oh-my-zsh: one shared, root-owned install for pi and root - not writable by either.
RUN chown -R root:root /opt/oh-my-zsh
RUN chmod -R go-w /opt/oh-my-zsh

# Same .zshrc for root (hardcodes ZSH=/opt/oh-my-zsh, so it works for either account).
INSTALL home/pi/.zshrc /root/.zshrc
RUN chown root:root /root/.zshrc

# Fix permissions for network manager system connections
RUN sh -c 'chmod 600 /etc/NetworkManager/system-connections/*'

# Enable copy-authorized-keys
RUN systemctl enable copy-authorized-keys.service
RUN systemctl enable copy-authorized-keys.path

# Seed pi's default password as a userconf file - userconfig.service (below)
# applies and deletes it on first boot, same as an operator-supplied one.
RUN sh -c 'echo "pi:$(echo "natur" | openssl passwd -6 -stdin)" > /boot/firmware/userconf.txt'
RUN usermod -s /bin/zsh pi
RUN usermod -s /bin/zsh root
RUN rm /etc/ssh/sshd_config.d/rename_user.conf

# userconf-service is patched to fix Trixie's shell-reset bug - see docs/security.md.
RUN systemctl enable userconfig.service

# pi has no sudo access at all - every privileged action is gated by polkit
# or group membership instead (see docs/security.md). Stays in `netdev` for
# NetworkManager access; `|| true` since group membership varies by base image.
RUN sh -c 'deluser pi sudo || true'
RUN sh -c 'deluser pi adm || true'

# Full journal read access - journald gates this by group, not polkit (see docs/security.md).
RUN usermod -aG systemd-journal pi

# root's password is a build-time secret via TSOS_ROOT_PASSWORD, never
# committed here - see docs/security.md, "Root password (build-time, optional)".
# Setting one also enables password SSH for root, which is key-only otherwise.
RUN sh -c 'if [ -n "$TSOS_ROOT_PASSWORD" ]; then \
        echo "root:$(echo "$TSOS_ROOT_PASSWORD" | openssl passwd -6 -stdin)" | chpasswd -e; \
        sed -i "s/^PermitRootLogin .*/PermitRootLogin yes/" /etc/ssh/sshd_config.d/10-tsos.conf; \
    else \
        passwd -l root; \
    fi'

# Change default editor to vim
RUN update-alternatives --set editor /usr/bin/vim.basic

# Allow basic connectivity (0 == success status code - enable)
RUN raspi-config nonint do_ssh 0

RUN raspi-config nonint do_i2c 0
# Enable second I2C bus (i2c_vc) and 400 kHz on ARM I2C (bus 1)
RUN sed -i 's/^#\?dtparam=i2c_arm=.*/dtparam=i2c_arm=on,i2c_arm_baudrate=400000/' /boot/firmware/config.txt
RUN tee -a /boot/firmware/config.txt <<EOF
dtparam=i2c_vc=on

EOF

# Disable Swap
RUN systemctl mask rpi-resize-swap-file.service

# Enable persistent journal
RUN rm /usr/lib/systemd/journald.conf.d/40-rpi-volatile-storage.conf

# disable unnecessary services
RUN systemctl mask rpi-eeprom-update.service
RUN systemctl mask apt-daily-upgrade.timer
RUN systemctl mask apt-daily.timer
RUN systemctl mask apt-listchanges.timer
RUN systemctl mask dpkg-db-backup.timer dpkg-db-backup.service
RUN touch /etc/cloud/cloud-init.disabled

# rebuild initramfs
RUN update-initramfs -k all -u -v
RUN systemctl mask rpi-resize.service
RUN systemctl mask systemd-remount-fs.service

# install gitui
RUN sh -c "wget -O- https://github.com/gitui-org/gitui/releases/download/v0.28.1/gitui-linux-aarch64.tar.gz | tar -xzC /usr/local/bin/"

# enable hostname-config script and set default hostname
RUN systemctl enable hostname-config.service

# Switch to chrony unrestricted service
RUN rm /usr/lib/systemd/system/chronyd-restricted.service

# Enabling wait for time-sync.target (depending services will not start before the clock is synced)
RUN systemctl enable chrony-wait.service chrony-wait-stop.path

# Set build-timestamp to last known time: systemd (PID 1) advances the clock to this
# file's mtime at boot. The directory went with the systemd-timesyncd purge.
RUN mkdir -p /var/lib/systemd/timesync
RUN touch /var/lib/systemd/timesync/clock

# Configure hardware connectivity
RUN raspi-config nonint do_serial_hw 0

# assure high-reliabilty boot configuration
RUN tee -a /boot/firmware/config.txt <<EOF
kernel_watchdog_timeout=15

EOF

# Enable UART0 on GPIO header in RPi5 
RUN tee -a /boot/firmware/config.txt <<EOF
[pi5]
dtoverlay=uart0-pi5

EOF

# enable otg mode on pi4
RUN tee -a /boot/firmware/config.txt <<EOF
[pi4]
otg_mode=1

EOF

# Install the WittyPi RTC driver and overlay, prebuilt by the wittypi4 release.
# Fails if the release has no module for an installed kernel (e.g. after a kernel bump).
RUN curl -fsSL -o /tmp/wittypi4-modules.tar.gz https://github.com/trackIT-Systems/wittypi4/releases/download/0.2.0/rtc-pcf85063-wittypi4-modules.tar.gz
# Unpack aside, not into /: the archive's lib/ would replace the /lib -> usr/lib symlink.
RUN mkdir /tmp/wittypi4
RUN tar -xzf /tmp/wittypi4-modules.tar.gz -C /tmp/wittypi4
RUN sh -c 'for k in /usr/lib/modules/*; do v=$(basename $k); install -D -m 644 /tmp/wittypi4/lib/modules/$v/updates/rtc-pcf85063-wittypi4.ko $k/updates/rtc-pcf85063-wittypi4.ko && depmod $v || exit 1; done'
RUN install -m 644 /tmp/wittypi4/boot/firmware/overlays/wittypi4.dtbo /boot/firmware/overlays/wittypi4.dtbo
RUN rm -rf /tmp/wittypi4 /tmp/wittypi4-modules.tar.gz

### enable wittypi on pi3 and pi4
RUN tee -a /boot/firmware/config.txt <<EOF
[pi4]
dtoverlay=wittypi4

[pi3]
dtoverlay=wittypi4

[all]
EOF

### install python daemon
RUN apt-get install -y python3-astral python3-pytimeparse
RUN python3 -m pip install --no-deps https://github.com/trackIT-Systems/scheduleparse/archive/refs/tags/2026.10.1.tar.gz
RUN python3 -m pip install --no-deps -e /usr/local/src/tsschedule
RUN systemctl enable tsschedule.service

#################################################
### network configuration

RUN raspi-config nonint do_wifi_country "DE"

# enable wireguard
RUN ln -s /boot/firmware/wireguard.conf /etc/wireguard/wireguard.conf
RUN systemctl enable wg-quick@wireguard

# disable networkd-wait-online
RUN systemctl mask systemd-networkd-wait-online.service

#################################################
### services configuration

# install and enable enable tsconfig
# python3-httpx is imported at module level by tsconfig (auth, BLE gateway, routers). It is
# listed here explicitly: this image sets APT::Install-Recommends "0" (etc/apt/apt.conf.d), so
# it is not pulled in as a Recommends of python3-fastapi - it only used to arrive as a Recommends
# of samba, which was installed before that setting took effect.
RUN apt-get install -y python3-fastapi python3-uvicorn python3-websockets python3-jinja2 python3-python-multipart python3-yaml python3-dateutil python3-psutil python3-httpx
RUN python3 -m pip install --no-deps -e /usr/local/src/tsconfig
INSTALL usr/local/src/tsconfig/configs/tsconfig.yml /boot/firmware/tsconfig.yml
RUN systemctl enable tsconfig tsconfig-ble

# install default config
RUN tsconfig zip -f -b forbid /home/pi/tsos-default-name_config.zip

# install tsupdate
RUN apt-get install -y python3-aiohttp python3-github gh
RUN python3 -m pip install --no-deps -e /usr/local/src/tsupdate
RUN systemctl enable tsupdate

# install tsflash (rich: same story as httpx above - it used to arrive via samba's Recommends)
RUN apt-get install -y python3-tqdm python3-rich
RUN python3 -m pip install --no-deps -e /usr/local/src/tsflash

# enable devmon
RUN systemctl enable devmon.service

# enable caddy
RUN systemctl enable caddy

# enable filebrowser
RUN systemctl enable filebrowser

# enable mosquitto
RUN systemctl enable mosquitto.service

# Install pysmartsolar
RUN apt-get install -y python3-cbor2
RUN python3 -m pip install --no-deps gatt
RUN python3 -m pip install --no-deps -e /usr/local/src/pysmartsolar

# Install vedirect_dump (pyserial is also used by pyenvsense's sensirion_shdlc_driver;
# it only used to arrive as a dependency of gpsd-clients)
RUN apt-get install -y python3-serial
RUN python3 -m pip install --no-deps ve_utils vedirect_m8
RUN python3 -m pip install --no-deps -e /usr/local/src/vedirect_dump

# Install solarlife
RUN apt-get install -y python3-bleak
RUN python3 -m pip install --no-deps -e /usr/local/src/pysolarlife

# Install vcgencmd
RUN python3 -m pip install --no-deps -e /usr/local/src/vcgencmd

# Install and enable pymqttutil
RUN apt-get install -y python3-schedule python3-paho-mqtt python3-pytimeparse python3-dotenv
RUN python3 -m pip install --no-deps -e /usr/local/src/pymqttutil
RUN systemctl enable mqttutil.service

# Install pyenvsense and modules
RUN python3 -m pip install --no-deps -e /usr/local/src/pyenvsense
RUN python3 -m pip install sensirion-i2c-sht3x==1.0.0 sensirion-i2c-sht4x==1.0.0 
RUN systemctl enable envsense.service

# Install uhubctl (dependency) and enable huaweicheck
RUN apt-get install -y uhubctl
RUN systemctl enable huaweicheck.timer
RUN systemctl enable wificheck.timer
RUN systemctl enable wificheck.path
RUN systemctl enable brovi_startup.service

# Blacklist DVB-T driver
RUN tee -a /etc/modprobe.d/raspi-blacklist.conf <<<'blacklist dvb_usb_rtl28xxu'

# Enable repartition-cleanup
RUN systemctl enable repartition-cleanup.service

# Enable gpsd
RUN systemctl enable gpsd

# Link static location file
RUN ln -s /boot/firmware/geolocation /etc/geolocation

# Enable i2s
RUN sed -i 's/#dtparam=i2s=on/dtparam=i2s=on/' /boot/firmware/config.txt

# Cleanup image
RUN rm -rf /var/lib/apt/lists/
RUN apt-get clean
RUN rm -rf /var/cache/
RUN rm -rf /root/.cache/pip

ZERO
SHRINK
